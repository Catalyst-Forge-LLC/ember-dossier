{
	"name": "ember-dossier-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node ../scripts/sync-skill-static.mjs && node ../scripts/ensure-lease.mjs ember-dossier-site 5196 && filepress dev --host 0.0.0.0",
		"build": "node ../scripts/sync-skill-static.mjs && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=emberdossier",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"getfilepress": "^0.1.10",
		"wrangler": "^4.124.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}

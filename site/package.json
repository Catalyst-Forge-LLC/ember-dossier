{
	"name": "ember-dossier-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node ../scripts/sync-skill-static.mjs && localslip claim ember-dossier-site --port 5196 && filepress dev --host 0.0.0.0",
		"build": "node ../scripts/sync-skill-static.mjs && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=emberdossier",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"getfilepress": "^0.1.33",
		"wrangler": "^4.124.0"
	},
	"pnpm": {
		"overrides": {
			"sharp": "0.35.4",
			"cookie@<0.7.0": "0.7.2",
			"js-yaml": "3.15.2"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}
